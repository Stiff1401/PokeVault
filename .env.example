# Only needed for the optional self-hosted backend. The static community
# edition needs no environment variables at all.

# --- docker compose ---
POSTGRES_PASSWORD=change-me
PV_PORT=3000
# Comma-separated origins allowed to call the sync API, or * for any.
# Restrict this when a static PokéVault frontend on another host syncs here.
PV_CORS_ORIGINS=*

# --- running the self-hosted build without Docker ---
DATABASE_URL="postgresql://pokevault:change-me@localhost:5432/pokevault?schema=public"

# --- both builds: sub-path hosting, e.g. /pokevault for https://user.github.io/pokevault ---
NEXT_PUBLIC_BASE_PATH=
